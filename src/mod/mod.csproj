<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>Sparky</AssemblyName>
    <RootNamespace>Sparky</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Vintage Story API -->
    <!-- You'll need to set the VINTAGE_STORY environment variable to point to your VS installation -->
    <!-- Example: export VINTAGE_STORY=/path/to/vintagestory -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Reference to VSSurvivalMod for BlockEntityMicroBlock inheritance -->
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Reference to protobuf-net for network message serialization -->
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../core/core.csproj" />
  </ItemGroup>

  <!-- Copy resources to output folder on Release builds -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="../../resources/**" CopyToOutputDirectory="PreserveNewest" Link="resources/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../assets/**" CopyToOutputDirectory="PreserveNewest" Link="assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../modinfo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Package the mod as a zip file after building -->
  <Target Name="Package" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(MSBuildProjectDirectory)/bin" />
    <ZipDirectory
      DestinationFile="$(MSBuildProjectDirectory)/bin/$(TargetName).zip"
      SourceDirectory="$(TargetDir)"
      Overwrite="true"
    />
  </Target>
</Project>
